     return status;
   }
+  // A host that rotates its own textures through a borrowed ring of the same
+  // size replaces the target before each frame. Such a replacement brings no
+  // new map state, so it keeps the record of the rendered update, and a
+  // render-if-needed demand renders only when the map has a newer update, as
+  // maplibre-native-ffi#807 did for the earlier set_target.
+  const auto same_size_borrowed = [&] {
+    const auto lock = std::scoped_lock{live->control_mutex};
+    return kind == RetargetTargetKind::BorrowedTexture &&
+           live->width == extent.width && live->height == extent.height &&
+           live->scale_factor == extent.scale_factor &&
+           live->physical_width == physical_width &&
+           live->physical_height == physical_height;
+  }();
 
   const auto replace_status = [&]() -> mln_status {
     try {
@@ -1855,15 +1868,23 @@ auto render_session_set_target(
